generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  OPERATOR
}

enum ApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEEDS_CORRECTION
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostType {
  ARTICLE
  VIDEO
  IMAGE
  EVENT_COVERAGE
  ANNOUNCEMENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  CANCELLED
  REJECTED
  ATTENDED
}

enum VonalpVocabularyType {
  VONALP
  VONALP_EP
}

enum VonalpSourceType {
  ENTRY
  TOPONYM
  ANTHROPONYM
  FOREIGNISM
}

enum VonalpCompletionStatus {
  COMPLETE
  INCOMPLETE
  ARCHIVED
}


model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            UserRole  @default(OPERATOR)
  profilePhotoUrl String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLogin       DateTime?
  lastPasswordChangeAt DateTime?
  supervisorId    String?
  supervisor      User?     @relation("SupervisorOperators", fields: [supervisorId], references: [id], onDelete: SetNull)
  managedOperators User[]   @relation("SupervisorOperators")
  
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  
  // Relations to content
  createdEntries     Entry[]        @relation("EntryCreatedBy")
  updatedEntries     Entry[]        @relation("EntryUpdatedBy")
  approvedEntries    Entry[]        @relation("EntryApprovedBy")

  createdNeologisms  Neologism[]    @relation("NeologismCreatedBy")
  updatedNeologisms  Neologism[]    @relation("NeologismUpdatedBy")
  approvedNeologisms Neologism[]    @relation("NeologismApprovedBy")
  
  createdToponyms    Toponym[]      @relation("ToponymCreatedBy")
  updatedToponyms    Toponym[]      @relation("ToponymUpdatedBy")
  approvedToponyms   Toponym[]      @relation("ToponymApprovedBy")

  createdAnthroponyms Anthroponym[] @relation("AnthroponymCreatedBy")
  updatedAnthroponyms Anthroponym[] @relation("AnthroponymUpdatedBy")
  approvedAnthroponyms Anthroponym[] @relation("AnthroponymApprovedBy")

  createdForeignisms  Foreignism[]  @relation("ForeignismCreatedBy")
  updatedForeignisms  Foreignism[]  @relation("ForeignismUpdatedBy")
  approvedForeignisms Foreignism[]  @relation("ForeignismApprovedBy")

  blogPosts          BlogPost[]
  events             Event[]
  mediaAssets        MediaAsset[]
  reports            Report[]
  notifications      Notification[]
  createdVonalpTerms VonalpTerm[] @relation("VonalpTermCreatedBy")
  updatedVonalpTerms VonalpTerm[] @relation("VonalpTermUpdatedBy")
  sourceVonalpTerms  VonalpTerm[] @relation("VonalpTermSourceCreatedBy")
  createdVolnaTerms  VolnaTerm[]  @relation("VolnaTermCreatedBy")
  updatedVolnaTerms  VolnaTerm[]  @relation("VolnaTermUpdatedBy")
  approvedVolnaTerms VolnaTerm[]  @relation("VolnaTermApprovedBy")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("users")
  @@index([supervisorId])
}

model RefreshToken {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime @default(now())

  @@map("refresh_tokens")
}

model AuditLog {
  id            String    @id @default(uuid())
  actorId       String?
  actor         User?     @relation(fields: [actorId], references: [id])
  actorRole     UserRole?
  action        String
  entity        String
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  status        String
  failureReason String?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@map("audit_logs")
}

model Entry {
  id                     String         @id @default(uuid())
  entry                  String
  pronunciation          String?
  syllabicDivision       String?
  etymology              String?
  firstDefinition        String
  secondDefinition       String?
  thirdDefinition        String?
  usageExample           String?
  abbreviation           String?
  acronym                String?
  acronymMeaning         String?
  reduction              String?
  reductionMeaning       String?
  shortForm              String?
  fullForm               String?
  grammaticalCategory    String?
  grammaticalSubcategory String?
  grammaticalStatus      String?
  languageCode           String?
  audioUrl               String?
  imageUrl               String?
  videoUrl               String?
  isVocabulary           Boolean        @default(false)
  isVocabularyEP         Boolean        @default(false)
  isForeignism           Boolean        @default(false)

  // Approval metadata
  createdById            String?
  createdBy              User?          @relation("EntryCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?          @relation("EntryUpdatedBy", fields: [updatedById], references: [id])
  approvedById           String?
  approvedBy             User?          @relation("EntryApprovedBy", fields: [approvedById], references: [id])
  approvalStatus         ApprovalStatus @default(DRAFT)
  approvedAt             DateTime?
  submittedAt            DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  correctionNotes        String?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("entries")
}

model Neologism {
  id                     String         @id @default(uuid())
  entry                  String
  pronunciation          String?
  syllabicDivision       String?
  etymology              String?
  firstDefinition        String
  secondDefinition       String?
  thirdDefinition        String?
  usageExample           String?
  abbreviation           String?
  acronym                String?
  acronymMeaning         String?
  reduction              String?
  reductionMeaning       String?
  shortForm              String?
  fullForm               String?
  grammaticalCategory    String?
  grammaticalSubcategory String?
  grammaticalStatus      String?
  languageCode           String?
  audioUrl               String?
  imageUrl               String?
  videoUrl               String?
  isVocabulary           Boolean        @default(false)
  isVocabularyEP         Boolean        @default(false)
  isForeignism           Boolean        @default(false)

  // Approval metadata
  createdById            String?
  createdBy              User?          @relation("NeologismCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?          @relation("NeologismUpdatedBy", fields: [updatedById], references: [id])
  approvedById           String?
  approvedBy             User?          @relation("NeologismApprovedBy", fields: [approvedById], references: [id])
  approvalStatus         ApprovalStatus @default(DRAFT)
  approvedAt             DateTime?
  submittedAt            DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  correctionNotes        String?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("neologisms")
}

model Anthroponym {
  id                     String         @id @default(uuid())
  name                   String
  gender                 String?
  etymology              String?
  meaning                String?
  surname                String?
  surnameMeaning         String?
  historicalFigure       String?
  historicalFigurePseudonym String?
  historicalFigureDomain String?
  isVocabulary           Boolean        @default(false)
  isVocabularyEP         Boolean        @default(false)
  isForeignism           Boolean        @default(false)

  // Approval metadata
  createdById            String?
  createdBy              User?          @relation("AnthroponymCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?          @relation("AnthroponymUpdatedBy", fields: [updatedById], references: [id])
  approvedById           String?
  approvedBy             User?          @relation("AnthroponymApprovedBy", fields: [approvedById], references: [id])
  approvalStatus         ApprovalStatus @default(DRAFT)
  approvedAt             DateTime?
  submittedAt            DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  correctionNotes        String?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("anthroponyms")
}

model Toponym {
  id                String         @id @default(uuid())
  toponym           String
  pronunciation     String?
  meaning           String?
  province          String
  municipality      String?
  location          String?
  gentilic          String?
  locationImage     String?
  toponymHistory    String?
  toponymProvenance String?
  commonUsage       String?
  graphicVariation  String?
  toponymClasses    String[]
  toponymSubclasses String[]
  status            String?
  languageCode      String?
  isVocabulary      Boolean        @default(false)
  isVocabularyEP    Boolean        @default(false)
  isForeignism      Boolean        @default(false)

  // Approval metadata
  createdById       String?
  createdBy         User?          @relation("ToponymCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?          @relation("ToponymUpdatedBy", fields: [updatedById], references: [id])
  approvedById      String?
  approvedBy        User?          @relation("ToponymApprovedBy", fields: [approvedById], references: [id])
  approvalStatus    ApprovalStatus @default(DRAFT)
  approvedAt        DateTime?
  submittedAt       DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  correctionNotes   String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("toponyms")
}

model Foreignism {
  id                     String         @id @default(uuid())
  term                   String
  pronunciation          String?
  originalLanguage       String?
  originCountry          String?
  adaptedForm            String?
  originalForm           String?
  meaning                String?
  definition             String?
  usageExample           String?
  context                String?
  field                  String?
  abbreviation           String?
  acronym                String?
  reduction              String?
  shortForm              String?
  fullForm               String?
  grammaticalCategory    String?
  isVocabulary           Boolean        @default(false)
  isVocabularyEP         Boolean        @default(false)

  // Approval metadata
  createdById            String?
  createdBy              User?          @relation("ForeignismCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?          @relation("ForeignismUpdatedBy", fields: [updatedById], references: [id])
  approvedById           String?
  approvedBy             User?          @relation("ForeignismApprovedBy", fields: [approvedById], references: [id])
  approvalStatus         ApprovalStatus @default(DRAFT)
  approvedAt             DateTime?
  submittedAt            DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  correctionNotes        String?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("foreignisms")
}

model BlogPost {
  id               String      @id @default(uuid())
  title            String
  slug             String      @unique
  excerpt          String?
  content          String?
  coverImageUrl    String?
  videoUrl         String?
  galleryImageUrls String[]
  type             PostType
  status           PostStatus  @default(DRAFT)
  category         String?
  tags             String[]
  isFeatured       Boolean     @default(false)
  authorId         String
  author           User        @relation(fields: [authorId], references: [id])
  publishedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("blog_posts")
}

model Event {
  id                 String      @id @default(uuid())
  title              String
  slug               String      @unique
  description        String?
  category           String?
  coverImageUrl      String?
  startDate          DateTime
  endDate            DateTime
  location           String
  registrationCount  Int         @default(0)
  maxRegistrations   Int?
  registrations      EventRegistration[]
  status             EventStatus @default(DRAFT)
  createdById        String
  createdBy          User        @relation(fields: [createdById], references: [id])
  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("events")
}

model EventRegistration {
  id              String             @id @default(uuid())
  eventId         String
  event           Event              @relation(fields: [eventId], references: [id])
  name            String
  email           String
  phone           String?
  organization    String?
  status          RegistrationStatus @default(PENDING)
  notes           String?
  attended        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([eventId, email])
  @@map("event_registrations")
}


model MediaAsset {
  id              String   @id @default(uuid())
  url             String
  filename        String?
  mimeType        String?
  size            Int?
  storageProvider String?
  uploadedById    String?
  uploadedBy      User?    @relation(fields: [uploadedById], references: [id])
  entity          String?
  entityId        String?
  createdAt       DateTime @default(now())

  @@map("media_assets")
}

model Report {
  id              String   @id @default(uuid())
  type            String   // users, activity, summary
  status          String   // GENERATING, COMPLETED, FAILED
  url             String?
  filename        String
  parameters      Json?
  generatedById   String?
  generatedBy     User?    @relation(fields: [generatedById], references: [id])
  createdAt       DateTime @default(now())

  @@map("reports")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  entity    String?
  entityId  String?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@map("notifications")
  @@index([userId, readAt])
  @@index([createdAt])
}

model VonalpTerm {
  id                     String                 @id @default(uuid())
  vocabularyType         VonalpVocabularyType
  sourceType             VonalpSourceType
  sourceId               String
  sourceCreatedById      String?
  sourceCreatedBy        User?                  @relation("VonalpTermSourceCreatedBy", fields: [sourceCreatedById], references: [id], onDelete: SetNull)
  term                   String?
  pronunciation          String?
  grammaticalCategory    String?
  grammaticalSubcategory String?
  syllabicDivision       String?
  etymology              String?
  firstDefinition        String?
  secondDefinition       String?
  origin                 String?
  completionStatus       VonalpCompletionStatus @default(INCOMPLETE)
  missingFields          String[]               @default([])
  createdById            String?
  createdBy              User?                  @relation("VonalpTermCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?                  @relation("VonalpTermUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([vocabularyType, sourceType, sourceId])
  @@index([vocabularyType, completionStatus])
  @@index([sourceType, sourceId])
  @@index([sourceCreatedById])
  @@map("vonalp_terms")
}

model VolnaTerm {
  id                     String         @id @default(uuid())
  term                   String
  language               String
  grammaticalCategory    String?
  grammaticalSubcategory String?
  definition             String
  usageExample           String?
  notes                  String?
  approvalStatus         ApprovalStatus @default(DRAFT)
  createdById            String?
  createdBy              User?          @relation("VolnaTermCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?          @relation("VolnaTermUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedById           String?
  approvedBy             User?          @relation("VolnaTermApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt             DateTime?
  submittedAt            DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  correctionNotes        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([term, language])
  @@index([language, approvalStatus])
  @@index([grammaticalCategory])
  @@index([createdById])
  @@map("volna_terms")
}
