DATABASE_URL="postgresql://johndoe:randompassword@localhost:5439/mydb?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV=development
PORT=4000

# Comma-separated browser origins. Required in production.
FRONTEND_URL="http://localhost:3000"

# Upload limits
VOCABULARY_MAX_FILE_MB=20
MEDIA_MAX_FILE_MB=10

R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Optional in local/demo mode. When empty, emails are skipped instead of crashing the API.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

MISTRAL_API_KEY=""
MISTRAL_OCR_MODEL="mistral-ocr-latest"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

VOCABULARY_MAX_FILE_MB=20
VOCABULARY_CHUNK_WORDS=1200
