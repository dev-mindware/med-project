# ==============================================================================
# 🌐 APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=4000
MED_API_PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# ==============================================================================
# 🗄️ DATABASE (PostgreSQL & Prisma)
# ==============================================================================
POSTGRES_USER=johndoe
POSTGRES_PASSWORD=randompassword
POSTGRES_DB=mydb
POSTGRES_PORT=5439

# Prisma database connection string
# Local development (direct):
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5439/mydb?schema=public"
# Docker container environment:
# DATABASE_URL="postgresql://johndoe:randompassword@postgres:5432/mydb?schema=public"

# Automatically run prisma migrations on container startup (true/false)
RUN_MIGRATIONS=false

# ==============================================================================
# 🔐 AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
JWT_ACCESS_SECRET="change-me-to-a-secure-random-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-secure-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================================================
# 📦 CLOUD STORAGE (Cloudflare R2 / S3 Compatible)
# ==============================================================================
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Maximum upload file sizes in MB
MEDIA_MAX_FILE_MB=10
VOCABULARY_MAX_FILE_MB=20
VOCABULARY_CHUNK_WORDS=1200

# ==============================================================================
# ✉️ EMAIL SERVICE (Resend)
# ==============================================================================
# Optional in local dev: when empty, emails are gracefully skipped
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ==============================================================================
# 🤖 ARTIFICIAL INTELLIGENCE & OCR
# ==============================================================================
# Google Gemini (Default extraction engine)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_MODEL="gemini-2.5-flash"

# Mistral AI (OCR & document processing)
MISTRAL_API_KEY=""
MISTRAL_OCR_MODEL="mistral-ocr-latest"

# OpenAI (Alternative fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gemini-2.5-flash"
