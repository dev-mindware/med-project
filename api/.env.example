DATABASE_URL="postgresql://johndoe:randompassword@localhost:5439/mydb?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV=development
PORT=4000

# Comma-separated browser origins for both frontends (public-platform and back-office)
FRONTEND_URL="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Upload limits
VOCABULARY_MAX_FILE_MB=20
MEDIA_MAX_FILE_MB=10

R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Optional in local/demo mode. When empty, emails are skipped instead of crashing the API.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

MISTRAL_API_KEY=""
MISTRAL_OCR_MODEL="mistral-ocr-latest"

# AI Model Configuration (Gemini 2.5 Flash as default)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gemini-2.5-flash"

VOCABULARY_CHUNK_WORDS=1200
