# ==============================================================================
# 🌐 AMBIENTE & CONFIGURAÇÃO DA APLICAÇÃO (PRODUÇÃO)
# ==============================================================================
NODE_ENV=production
PORT=3009
MED_API_PORT=3009

# URLs dos frontends autorizados para CORS (separados por vírgula)
# IMPORTANTE: Coloque apenas os domínios reais de produção (sem barra final)
FRONTEND_URL="https://admin.linguistic.ao,https://linguistic.ao"

# ==============================================================================
# 🗄️ BASE DE DADOS (PostgreSQL & Prisma)
# ==============================================================================
# Defina credenciais seguras e fortes para a produção:
POSTGRES_USER=med_prod_user
POSTGRES_PASSWORD=gere_uma_senha_forte_aqui_exemplo_32_chars
POSTGRES_DB=med_linguistic_prod
POSTGRES_PORT=5432

# URL de ligação do Prisma dentro da rede Docker (o host é o serviço "postgres"):
DATABASE_URL="postgresql://med_prod_user:gere_uma_senha_forte_aqui_exemplo_32_chars@postgres:5432/med_linguistic_prod?schema=public"

# Executar migrações automaticamente no arranque do contentor (true em produção):
RUN_MIGRATIONS=true

# ==============================================================================
# 🔐 AUTENTICAÇÃO & SEGURANÇA (JWT)
# ==============================================================================
# Gere chaves criptográficas de 64 caracteres hexadecimais no terminal com:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="substitua_por_chave_hexadecimal_aleatoria_com_pelo_menos_64_caracteres"
JWT_REFRESH_SECRET="substitua_por_outra_chave_hexadecimal_aleatoria_com_pelo_menos_64_caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================================================
# 📦 CLOUD STORAGE (Cloudflare R2 / AWS S3 Compatível)
# ==============================================================================
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="seu_access_key_id_de_producao"
R2_SECRET_ACCESS_KEY="seu_secret_access_key_de_producao"
R2_BUCKET_NAME="med-linguistic-assets-prod"
R2_PUBLIC_URL="https://cdn.linguistic.ao"

# Limites de upload em MB
MEDIA_MAX_FILE_MB=25
VOCABULARY_MAX_FILE_MB=100
VOCABULARY_CHUNK_WORDS=2200

# ==============================================================================
# ✉️ SERVIÇO DE EMAIL (Resend)
# ==============================================================================
RESEND_API_KEY="re_prod_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Plataforma Linguística <nao-responder@linguistic.ao>"

# ==============================================================================
# 🤖 INTELIGÊNCIA ARTIFICIAL & OCR (Google Gemini - AO45)
# ==============================================================================
# Chave de API de produção do Google AI Studio ou Google Cloud Vertex AI
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_OCR_MODEL="gemini-2.5-flash"
AI_MODEL="gemini-2.5-flash"

# Alternativa / Fallback OpenAI (opcional)
OPENAI_API_KEY=""
OPENAI_MODEL="gemini-2.5-flash"
